        "content": "def mean(values):\n    if not values:\n        return 0\n    return sum(values) / len(values)\n\n\ndef summarize(values):\n    numbers = [v for v in values if v is not None]\n    if not numbers:\n        return {'count': 0, 'mean': 0, 'min': None, 'max': None}\n    return {\n        'count': len(numbers),\n        'mean': mean(numbers),\n        'min': min(numbers),\n        'max': max(numbers),\n    }\n"
